# 复制本文件为 `.env` 并填写真实值。`.env` 已被 git 忽略，勿提交密钥。
#
# ── Astro 前端（构建时注入，须以 PUBLIC_ 开头）────────────────────────────
# CWD 评论服务 API 根地址（空字符串则评论组件不发起请求）
PUBLIC_CWD_API_BASE_URL=https://example.com
# 可选：自定义评论区样式表 URL（相对站点根路径或绝对 URL）
# PUBLIC_CWD_CUSTOM_CSS_URL=/cwd-custom.css
# PUBLIC_CWD_CUSTOM_CSS_URL=https://example.com/cwd-custom.css

# ── 同步脚本与 gosync（scripts/sync_obsidian.py、scripts/gosync）──────────
# 兼容 OpenAI Chat Completions 的大模型接口；未设置 AI_API_KEY 时跳过 AI 生成 frontmatter
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# 对象存储（S3 兼容，如七牛、MinIO 等）
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
# 桶内文章目录前缀，例如 Obsidian 同步到桶里的 website/ 下
S3_PREFIX=website/

# gosync HTTP 接口校验（可选；若未配置则按你的 main.go 逻辑处理）
WEBHOOK_SECRET=
# 服务端监听端口（可选，默认 3001）；配合 Nginx 反代见 scripts/gosync/deploy/
# PORT=3001
